# Copy this file to .env and set your store URL and product handles.
# The pnpm test runner loads .env; explicit environment variables take precedence.
STORE_URL=https://zerno.co
PRODUCT_HANDLE=zerno-z1
PRODUCT_HANDLE_2=zerno-z2
SEARCH_TERM=zerno

# Conservative live request pacing (milliseconds)
TEST_DELAY_MS=5000
TEST_JITTER_MS=3000
REQUEST_DELAY_MS=2000
REQUEST_JITTER_MS=2000

# Single-store locale defaults (sites.json values override these)
STORE_LOCALE=bg-BG
STORE_TIMEZONE=Europe/Sofia
