{
  "name": "e-commerce-tester",
  "version": "1.0.0",
  "description": "Automated health check for Shopify store",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "scripts": {
    "test": "bash run.sh",
    "test:headed": "bash run.sh --headed",
    "test:debug": "bash run.sh --debug",
    "dashboard": "open reports/dashboard.html 2>/dev/null || xdg-open reports/dashboard.html",
    "install:browsers": "pnpm exec playwright install chromium firefox webkit",
    "type-check": "tsc --noEmit",
    "lint": "eslint tests/ config/ *.ts",
    "lint:fix": "eslint tests/ config/ *.ts --fix",
    "format": "prettier --write \"tests/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"tests/**/*.ts\" \"*.ts\"",
    "test:unit": "node --test scripts/*.test.js",
    "check": "pnpm run type-check && pnpm run lint && pnpm run test:unit && pnpm run check:toolchain",
    "test:pacing": "STORE_URL=http://127.0.0.1:45679 SITE_SLUG=pacing-local REQUEST_DELAY_MS=60 REQUEST_JITTER_MS=0 TEST_DELAY_MS=0 TEST_JITTER_MS=0 playwright test --config=checks/pacing.config.ts",
    "dashboard:preview": "node scripts/preview-dashboard.js",
    "test:lighthouse:local": "node scripts/check-lighthouse.js",
    "test:readiness": "STORE_URL=http://127.0.0.1:45981 REQUEST_DELAY_MS=0 REQUEST_JITTER_MS=0 TEST_DELAY_MS=0 TEST_JITTER_MS=0 playwright test --config=checks/readiness.config.ts",
    "test:reporting": "node scripts/check-reporting.js",
    "test:smoke": "bash run.sh --mode smoke",
    "test:full": "bash run.sh --mode full",
    "test:visual": "bash run.sh --mode visual",
    "test:content": "bash run.sh --mode content",
    "check:toolchain": "node scripts/check-toolchain.js",
    "test:p2:local": "node scripts/check-p2.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "@types/nspell": "2.1.6",
    "dictionary-bg": "2.0.0",
    "dictionary-en": "4.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "lighthouse": "^13.5.0",
    "nspell": "2.1.5",
    "playwright-lighthouse": "^4.0.0",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
