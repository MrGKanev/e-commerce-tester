{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://e-commerce-tester.local/schemas/sites.json",
  "title": "Store configurations",
  "type": "array",
  "minItems": 1,
  "items": {
    "allOf": [
      {
        "$ref": "https://e-commerce-tester.local/schemas/site-settings.json"
      },
      {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string"
          },
          "slug": {
            "type": ["string", "null"],
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "productHandle": {
            "type": "string"
          },
          "productHandle2": {
            "type": "string"
          },
          "searchTerm": {
            "type": "string"
          },
          "discountCode": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    ]
  }
}
